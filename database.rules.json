{
  "rules": {
    "salas": {
      "$sala": {
        ".read": true,
        ".write": "!data.exists() || data.child('criada').val() > now - 86400000",
        ".validate": "newData.hasChildren(['criada', 'qids'])",
        "criada": {
          ".validate": "data.exists() ? newData.val() == data.val() : newData.val() == now"
        },
        "qids": {
          ".validate": "newData.isString() && newData.val().length <= 400 && (!data.exists() || newData.val() == data.val())"
        },
        "jog": {
          "$p": {
            ".validate": "($p == 'a' || $p == 'b') && newData.hasChildren(['on'])",
            "on": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "q": {
          "$i": {
            ".validate": "newData.isNumber() && newData.val() > now - 120000 && newData.val() < now + 60000"
          }
        },
        "r": {
          "$p": {
            ".validate": "$p == 'a' || $p == 'b'",
            "$i": {
              ".validate": "!data.exists() && newData.hasChildren(['l'])",
              "l": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              },
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ranking": {
      "$dia": {
        ".read": true,
        ".indexOn": [
          "km"
        ],
        "$e": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['nome', 'km', 'modo', 'em'])",
          "nome": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "km": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7000 && newData.val() % 100 == 0"
          },
          "modo": {
            ".validate": "newData.isString() && newData.val().matches(/^(diario|arquivo|infinito|duelo)$/)"
          },
          "em": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "historia": {
      ".read": true,
      ".indexOn": [
        "km"
      ],
      "$e": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['nome', 'km', 'modo', 'em', 'dia'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "km": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7000 && newData.val() % 100 == 0"
        },
        "modo": {
          ".validate": "newData.isString() && newData.val().matches(/^(diario|arquivo|infinito|duelo)$/)"
        },
        "em": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        },
        "dia": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        }
      }
    }
  }
}
